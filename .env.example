# Web service
POLAR_APP_HOST=127.0.0.1
POLAR_APP_PORT=8000
POLAR_APP_TIMEZONE=Europe/Berlin
POLAR_APP_DATABASE_PATH=database/polar-app.sqlite3
POLAR_APP_SYNC_INTERVAL_MINUTES=60
POLAR_APP_PUBLIC_BASE_URL=http://localhost:8000
POLAR_APP_SQLITE_VFS=unix-dotfile
POLAR_APP_SQLITE_JOURNAL_MODE=DELETE
# Optional external Python environment path, useful when this directory is on a noexec mount.
POLAR_APP_VENV=
# Optional absolute path to the uv binary when it is not on PATH.
UV_BIN=

# Polar OAuth credentials: leave empty until a client is created.
POLAR_APP_POLAR_CLIENT_ID=
POLAR_APP_POLAR_CLIENT_SECRET=
POLAR_APP_POLAR_REDIRECT_URI=http://localhost:8000/api/polar/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable; changing it makes existing stored Polar tokens unreadable.
POLAR_APP_POLAR_TOKEN_ENCRYPTION_KEY=
